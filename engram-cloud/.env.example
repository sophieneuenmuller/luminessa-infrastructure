# --- Engram Cloud Configuration ---

# Security: Generate a strong secret with:
# openssl rand -base64 32
ENGRAM_JWT_SECRET=YOUR_SECURE_JWT_SECRET

# Database Connection
# Pattern: postgresql://user:password@host:port/dbname
# Note: Use 'postgres' as host if running within the same Docker network
ENGRAM_DATABASE_URL=postgresql://engram_user:YOUR_PASSWORD@postgres:5432/engram_db

# Server Settings
ENGRAM_PORT=18080
ENGRAM_CLOUD_HOST=0.0.0.0

# Optional: Disable auth for initial testing (SET TO 0 FOR PRODUCTION)
ENGRAM_CLOUD_INSECURE_NO_AUTH=0

# Allowed projects (Comma-separated)
# Leave empty to allow any project reported by the CLI
ENGRAM_CLOUD_ALLOWED_PROJECTS=
