# Wireguard Easy configuration
# User and Group IDs for file ownership (e.g., 1000)
PUID=
PGID=

# The public hostname of the VPN server
WG_HOST=vpn.luminessa.net

# The password hash for the Web UI generated with bcryp out of the actual password
PASSWORD_HASH=changeme

# The port for the Wireguard tunnel (UDP)
WG_PORT=51820

# Optional: Set the default MTU for clients
# WG_MTU=1420

# Experimental AmneziaWG support
EXPERIMENTAL_AWG=true

# Timezone for the container
TZ=Europe/Madrid
