# Grimmory Configuration
# ---------------------

# MariaDB (DB sidecar) settings
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=grimmory
MYSQL_USER=grimmory_user
MYSQL_PASSWORD=change_me_user_password

# Grimmory Application settings
# Grimmory's port inside the container (default 6060)
GRIMMORY_PORT=6060

# External URL for Grimmory (used for links, OPDS, etc.)
GRIMMORY_EXTERNAL_URL=https://libros.luminessa.net

# Timezone for the container
TZ=Europe/Madrid
